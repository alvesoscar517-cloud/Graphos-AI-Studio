{
  "name": "ai-content-authenticator-backend",
  "version": "2.1.0",
  "description": "AI Content Authenticator - Node.js Backend with Gemini Ecosystem",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": "18"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "fast-check": "^3.15.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js"],
    "coveragePathIgnorePatterns": ["/node_modules/", "/__tests__/"]
  },
  "dependencies": {
    "@google-cloud/aiplatform": "^3.11.0",
    "bcryptjs": "^2.4.3",
    "@google-cloud/firestore": "^7.1.0",
    "@google-cloud/vertexai": "^1.1.0",
    "compromise": "^14.10.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "natural": "^6.10.0",
    "nodemailer": "^7.0.10",
    "uuid": "^9.0.1"
  }
}
