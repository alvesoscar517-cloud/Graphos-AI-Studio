{
  "name": "ai-content-authenticator-backend",
  "version": "2.1.0",
  "description": "Graphos AI Studio - Node.js Backend with Graphos AI Ecosystem",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "i18n:validate": "node scripts/validate-locales.js",
    "i18n:validate:fix": "node scripts/validate-locales.js --fix",
    "i18n:validate:verbose": "node scripts/validate-locales.js --verbose",
    "i18n:generate-types": "node scripts/generate-i18n-types.js"
  },
  "engines": {
    "node": "18"
  },
  "devDependencies": {
    "fast-check": "^3.15.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/"
    ]
  },
  "dependencies": {
    "@godaddy/terminus": "^4.12.1",
    "@google-cloud/aiplatform": "^3.11.0",
    "@google-cloud/firestore": "^7.1.0",
    "@google-cloud/vertexai": "^1.9.2",
    "@keyv/redis": "^5.1.4",
    "argon2": "^0.44.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.65.1",
    "compression": "^1.8.1",
    "convict": "^6.2.4",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "firebase-admin": "^12.0.0",
    "got": "=11.8.6",
    "http-errors": "^2.0.1",
    "ioredis": "^5.8.2",
    "keyv": "^5.5.4",
    "lru-cache": "^11.2.4",
    "nodemailer": "^7.0.10",
    "opossum": "^9.0.0",
    "otplib": "^12.0.1",
    "p-limit": "^3.1.0",
    "p-map": "^4.0.0",
    "p-retry": "^4.6.2",
    "p-timeout": "^4.1.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "rate-limiter-flexible": "^9.0.0",
    "sanitize-html": "^2.17.0",
    "uuid": "^9.0.1",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0",
    "yaml": "^2.8.2",
    "zod": "^4.1.13"
  }
}
