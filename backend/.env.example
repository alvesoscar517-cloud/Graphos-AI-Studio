# =============================================================================
# Graphos AI Studio - Backend Environment Variables
# =============================================================================

# Server Configuration
PORT=8080
NODE_ENV=development

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
VERTEX_AI_LOCATION=us-central1

# AI Models
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
MAX_TEXT_LENGTH=20000

# Redis (Optional - falls back to memory cache if not set)
# REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# =============================================================================
# Rate Limiting
# =============================================================================
# RATE_LIMIT_WINDOW=900000          # 15 minutes in ms
# RATE_LIMIT_MAX_REQUESTS=100       # Max requests per window (production)

# =============================================================================
# Caching Configuration (all values in milliseconds)
# =============================================================================
# CACHE_TTL_PROFILE=300000          # 5 minutes
# CACHE_TTL_EMBEDDING=1800000       # 30 minutes
# CACHE_TTL_ANALYSIS=600000         # 10 minutes
# CACHE_MAX_EMBEDDING=1000          # Max embedding cache entries
# CACHE_MAX_ANALYSIS=100            # Max analysis cache entries

# =============================================================================
# AI Detection Configuration
# =============================================================================
# AI_DETECTION_MAX_CHUNK_SIZE=3000  # Max chars per chunk for analysis
# AI_DETECTION_UNCERTAIN_LOW=35     # Lower bound for uncertain range (%)
# AI_DETECTION_UNCERTAIN_HIGH=65    # Upper bound for uncertain range (%)
# AI_DETECTION_DEEP_THRESHOLD=75    # Confidence threshold for deep analysis

# =============================================================================
# Feature Flags
# =============================================================================
# ENABLE_CACHING=true
# ENABLE_RATE_LIMITING=true         # Auto-enabled in production
# ENABLE_ANALYTICS=true             # Auto-enabled in production
# ENABLE_EMAIL=false
# ENABLE_DEBUG_ENDPOINTS=false      # NEVER enable in production!

# =============================================================================
# Security
# =============================================================================
# CORS (comma-separated list of allowed origins)
# CORS_WHITELIST=https://your-domain.com,chrome-extension://your-extension-id

# Session secret (REQUIRED in production)
# SESSION_SECRET=your-secure-random-string

# Input sanitization (enabled by default)
# SANITIZE_INPUT=true

# Request limits
# MAX_PROFILE_SAMPLES=100
# MAX_BATCH_SIZE=10
# REQUEST_TIMEOUT=30000

# =============================================================================
# Lemon Squeezy (Payment)
# =============================================================================
# LS_VARIANT_STARTER=123456
# LS_VARIANT_BASIC=123457
# LS_VARIANT_PRO=123458
# LS_VARIANT_PRO_PLUS=123459
# LS_VARIANT_POWER=123460
# LS_WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# Email Configuration (Google Workspace)
# =============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=admin@graphosai.com           # SMTP authentication user (admin email)
# SMTP_PASS=your-16-char-app-password
#
# Email aliases (IMPORTANT: Use correct alias for each type of email)
# EMAIL_FROM=no-reply@graphosai.com       # For OTP, security notifications (no-reply alias)
# EMAIL_FROM_NAME=Graphos AI Studio
# EMAIL_SUPPORT=support@graphosai.com     # For support ticket replies (support alias)
# EMAIL_BILLING=support@graphosai.com     # For billing-related emails (billing alias)

# Email Icons (GitHub Pages)
ICON_BASE_URL=https://alvesoscar517-cloud.github.io/icons-for-Gmail
# Available icons:
# - Logo: content.png
# - Black (light bg): mail-black.png, user-black.png, calendar-black.png, info-black.png,
#   circle-check-black.png, circle-alert-black.png, file-text-black.png, message-square-black.png,
#   credit-card-black.png, database-black.png, download-black.png, chart-bar-black.png
# - White (dark bg): mail-white.png, user-white.png, calendar-white.png, info-white.png,
#   circle-check-white.png, circle-alert-white.png, file-text-white.png, message-square-white.png,
#   credit-card-white.png, database-white.png, download-white.png, chart-bar-white.png

# =============================================================================
# Internal API (Backend-to-Backend Communication)
# =============================================================================
# API key for secure communication between admin backend and main backend
# Used for broadcasting notifications via SSE
# IMPORTANT: Generate a unique, secure key for production (min 64 chars)
# Example: openssl rand -hex 32
INTERNAL_API_KEY=your-secure-internal-api-key-change-in-production
