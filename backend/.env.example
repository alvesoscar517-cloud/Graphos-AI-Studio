# Server Configuration
PORT=8080
NODE_ENV=production

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
VERTEX_AI_LOCATION=us-central1

# Admin Configuration
ADMIN_KEY=your-secure-admin-key-here-change-this
ADMIN_PANEL_URL=https://your-domain.com/admin

# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Gemini Model
GEMINI_MODEL=gemini-2.0-flash-exp

# Feature Flags (optional)
# ENABLE_CACHING=true
# ENABLE_RATE_LIMITING=true
# ENABLE_ANALYTICS=true

# Redis Configuration (optional - falls back to in-memory cache if not set)
# REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://username:password@host:port

# Lemon Squeezy Payment Configuration
LEMON_SQUEEZY_API_KEY=your-lemon-squeezy-api-key
LEMON_SQUEEZY_STORE_ID=your-store-id
LEMON_SQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret

# Lemon Squeezy Variant IDs (map to credit packages)
LS_VARIANT_BASIC=your-basic-variant-id
LS_VARIANT_PRO=your-pro-variant-id
LS_VARIANT_PRO_PLUS=your-pro-plus-variant-id
LS_VARIANT_POWER=your-power-variant-id
