{
  "manifest_version": 3,
  "name": "AI Content Authenticator",
  "version": "1.0.1",
  "description": "A Chrome extension for AI content authentication and verification",
  "action": {
    "default_title": "Open AI Content Authenticator"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/content.png",
    "48": "icons/content.png",
    "128": "icons/content.png"
  },
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://ai-content-authenticator-472729326429.us-central1.run.app/*"
  ],
  "oauth2": {
    "client_id": "94136052128-r2rhnmicbq8q94agff7me9fipe8kh80q.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile",
      "https://www.googleapis.com/auth/drive.file"
    ]
  }
}
