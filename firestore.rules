rules_version = '2';
/**
 * Firestore Security Rules for Graphos AI Studio
 * 
 * SECURITY MODEL:
 * ================
 * - Backend uses Admin SDK (bypasses all rules) for write operations
 * - Frontend uses Web SDK for read-only realtime listeners
 * - Authentication is handled by backend (JWT/session), not Firebase Auth
 * - Data isolation is enforced by:
 *   1. Frontend queries always filter by userId (client-side)
 *   2. Backend validates userId before any write operation
 *   3. Sensitive data (passwords, tokens) is never exposed to frontend
 * 
 * COLLECTIONS:
 * - users: User profiles, credits, settings (read by owner)
 * - notifications: User notifications (read by owner, filtered by userId)
 * - user_notifications: User notifications realtime (read by owner, filtered by userId)
 * - voice_profiles: Voice profiles (read by owner, filtered by user_id)
 * - orders: Purchase orders (read by owner, filtered by userId)
 * - support_tickets: Support tickets (read by admin panel only)
 * - system_settings: System config (read by admin panel only)
 * - user_notes: User notes (read/write by owner) - NEW
 * - user_conversations: User conversations (read/write by owner) - NEW
 * - user_messages: Conversation messages (read/write by owner) - NEW
 * 
 * NOTE: Write operations are ALWAYS denied for Web SDK.
 * All writes go through authenticated backend API → Admin SDK.
 * 
 * EXCEPTION: user_notes, user_conversations, user_messages allow direct writes
 * from authenticated Firebase Auth users for offline-first sync.
 * 
 * Requirements: 9.1, 9.2, 9.3, 9.4, 9.5
 */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    
    // Check if request is a read operation
    function isReadOnly() {
      return request.method == 'get' || request.method == 'list';
    }
    
    // Check if user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns the document (userId field matches auth uid)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Validate note data structure
    function isValidNote() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'title', 'content', 'created', 'updated'])
        && data.userId is string
        && data.title is string
        && data.content is string
        && data.content.size() < 102400; // Max 100KB
    }
    
    // Validate conversation data structure
    function isValidConversation() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'title', 'created', 'updated'])
        && data.userId is string
        && data.title is string;
    }
    
    // Validate message data structure
    function isValidMessage() {
      let data = request.resource.data;
      return data.keys().hasAll(['conversationId', 'userId', 'role', 'content', 'timestamp'])
        && data.conversationId is string
        && data.userId is string
        && data.role in ['user', 'assistant']
        && data.content is string
        && data.content.size() < 51200; // Max 50KB
    }
    
    // =========================================================================
    // USERS COLLECTION
    // Read: Allowed (frontend reads own user doc by userId)
    // Write: Denied (backend only via Admin SDK)
    // =========================================================================
    match /users/{userId} {
      allow read: if isReadOnly();
      allow write: if false;
    }
    
    // =========================================================================
    // USER NOTES COLLECTION (NEW - Firestore Sync)
    // Read: Allowed for owner only
    // Write: Allowed for owner only with validation
    // Requirements: 9.1, 9.4, 9.5
    // =========================================================================
    match /user_notes/{noteId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && isValidNote();
      allow update: if isAuthenticated() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && isValidNote();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // =========================================================================
    // USER CONVERSATIONS COLLECTION (NEW - Firestore Sync)
    // Read: Allowed for owner only
    // Write: Allowed for owner only with validation
    // Requirements: 9.2, 9.4
    // =========================================================================
    match /user_conversations/{conversationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && isValidConversation();
      allow update: if isAuthenticated() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && isValidConversation();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // =========================================================================
    // USER MESSAGES COLLECTION (NEW - Firestore Sync)
    // Read: Allowed for owner only
    // Write: Allowed for owner only with validation
    // Requirements: 9.3, 9.4, 9.5
    // =========================================================================
    match /user_messages/{messageId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && isValidMessage();
      allow update: if isAuthenticated() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && isValidMessage();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // =========================================================================
    // NOTIFICATIONS COLLECTION
    // Read: Allowed (frontend queries with userId filter)
    // Write: Denied (backend only via Admin SDK)
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isReadOnly();
      allow write: if false;
    }
    
    // =========================================================================
    // USER NOTIFICATIONS COLLECTION
    // Read: Allowed (frontend realtime listener queries with userId filter)
    // Write: Denied (backend only via Admin SDK)
    // =========================================================================
    match /user_notifications/{notificationId} {
      allow read: if isReadOnly();
      allow write: if false;
    }
    
    // =========================================================================
    // VOICE PROFILES COLLECTION
    // Read: Allowed (frontend queries with user_id filter)
    // Write: Denied (backend only via Admin SDK)
    // =========================================================================
    match /voice_profiles/{profileId} {
      allow read: if isReadOnly();
      allow write: if false;
    }
    
    // =========================================================================
    // ORDERS COLLECTION
    // Read: Allowed (frontend queries with userId filter for payment detection)
    // Write: Denied (backend only via Admin SDK)
    // =========================================================================
    match /orders/{orderId} {
      allow read: if isReadOnly();
      allow write: if false;
    }
    
    // =========================================================================
    // SUPPORT TICKETS COLLECTION (Admin Panel)
    // Read: Allowed (admin panel reads all tickets)
    // Write: Denied (backend only via Admin SDK)
    // =========================================================================
    match /support_tickets/{ticketId} {
      allow read: if isReadOnly();
      allow write: if false;
    }
    
    // =========================================================================
    // SYSTEM SETTINGS (Admin Panel)
    // Read: Allowed (admin panel reads system config)
    // Write: Denied (backend only via Admin SDK)
    // =========================================================================
    match /system_settings/{settingId} {
      allow read: if isReadOnly();
      allow write: if false;
    }
    
    // =========================================================================
    // DEFAULT: Deny all other access
    // Any collection not explicitly listed above is blocked
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
