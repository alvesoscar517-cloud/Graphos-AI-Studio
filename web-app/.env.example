# =============================================================================
# Graphos AI Studio Web App - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Backend API URL
# Development: http://localhost:3000
# Production: https://your-backend-api.run.app
VITE_API_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Firebase Configuration (Required)
# -----------------------------------------------------------------------------
# Get these from Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# -----------------------------------------------------------------------------
# Google OAuth Configuration (Required for Web App)
# -----------------------------------------------------------------------------
# Get this from Google Cloud Console > APIs & Services > Credentials
# Create an OAuth 2.0 Client ID for "Web application"
# Add authorized JavaScript origins: http://localhost:5174, https://app.graphosai.com
# Add authorized redirect URIs: http://localhost:5174, https://app.graphosai.com
# Your Google OAuth Client ID (already configured for app.graphosai.com)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Google Drive API (Optional - for Drive integration)
# -----------------------------------------------------------------------------
# Same client ID as above, but ensure Drive API is enabled in Google Cloud Console
# Scopes needed: https://www.googleapis.com/auth/drive.file
VITE_GOOGLE_DRIVE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable development mode features (debug logs, dev tools)
VITE_ENABLE_DEV_MODE=true

# Enable performance monitoring
VITE_ENABLE_MONITORING=false

# -----------------------------------------------------------------------------
# Analytics (Optional)
# -----------------------------------------------------------------------------
# Google Analytics tracking ID
VITE_GA_TRACKING_ID=

# -----------------------------------------------------------------------------
# Development Only
# -----------------------------------------------------------------------------
# Mock user for testing (only used when VITE_ENABLE_DEV_MODE=true)
VITE_DEV_USER_EMAIL=test@example.com
VITE_DEV_USER_NAME=Test User
VITE_DEV_USER_ID=dev_user_123
