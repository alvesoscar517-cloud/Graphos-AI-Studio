# Environment Configuration
NODE_ENV=development

# API Configuration (Admin Panel)
# For development: use local backend
# VITE_API_URL=http://localhost:8080
# For production: use Cloud Run URL (default if not set)
# VITE_API_URL=https://ai-backend-admin-472729326429.us-central1.run.app

# Feature Flags
VITE_ENABLE_DEV_MODE=true
VITE_ENABLE_MONITORING=true
VITE_ENABLE_ERROR_TRACKING=false

# Analytics (Optional)
VITE_GA_TRACKING_ID=
VITE_SENTRY_DSN=

# Development - simulating Google OAuth login
VITE_DEV_USER_EMAIL=nguyen.vantest@gmail.com
VITE_DEV_USER_NAME=Nguyễn Văn Test
VITE_DEV_USER_ID=google_oauth_test_12345678901234567890
VITE_DEV_USER_PHOTO=https://lh3.googleusercontent.com/a/default-user=s96-c
