# =============================================================================
# Graphos AI Studio - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Options: development, production, test
NODE_ENV=development

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Backend API URL for the Chrome Extension
# Development: http://localhost:3000
# Production: Your deployed backend URL
VITE_API_BASE_URL=http://localhost:3000

# Admin Panel API URL
# Development: http://localhost:8080
# Production: Your deployed admin backend URL
VITE_API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Firebase Configuration (Required)
# -----------------------------------------------------------------------------
# Get these from Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable development mode features (debug logs, dev tools)
VITE_ENABLE_DEV_MODE=true

# Enable performance monitoring
VITE_ENABLE_MONITORING=true

# Enable error tracking (requires Sentry DSN)
VITE_ENABLE_ERROR_TRACKING=false

# -----------------------------------------------------------------------------
# Analytics & Monitoring (Optional)
# -----------------------------------------------------------------------------
# Google Analytics tracking ID
VITE_GA_TRACKING_ID=

# Sentry DSN for error tracking
VITE_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Development Only - Mock User for Testing
# -----------------------------------------------------------------------------
# These are used to simulate Google OAuth login in development
VITE_DEV_USER_EMAIL=test@example.com
VITE_DEV_USER_NAME=Test User
VITE_DEV_USER_ID=dev_user_123
VITE_DEV_USER_PHOTO=https://via.placeholder.com/96
